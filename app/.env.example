# Network the app talks to: testnet (default), mainnet or localnet
VITE_MONADB_NETWORK=testnet
# Optional: a deployments/monad-<network>.json inlined as one line of JSON
# ({"network":"testnet","chainId":10143,"rpcUrl":"…","contract":"0x…","nodes":["https://…"]}),
# to point the app at a contract other than the one built into the SDK
VITE_MONADB_DEPLOYMENT=
# Optional: or just the contract address (with the RPC and chain id below)
VITE_MONADB_CONTRACT=
# Optional: RPC endpoint for reads (defaults to the deployment's, then the public one;
# localnet uses http://127.0.0.1:8545)
VITE_MONADB_RPC_URL=
# Optional: chain id (10143 testnet, 143 mainnet, 31337 localnet)
VITE_MONADB_CHAIN_ID=
# Optional: comma-separated replicator URLs tried first
VITE_MONADB_NODE_URLS=
