# ──────────────────────────────────────────────────────
# MonaDB Node (Monad) — Environment Variables
# ──────────────────────────────────────────────────────

# HTTP port the NestJS server listens on
PORT=3000

# Allowed browser origins (comma-separated); empty = any origin
CORS_ORIGIN=

# ── Monad ──────────────────────────────────────────────
# A deployments/monad-<network>.json written by scripts/deploy.ts: gives the
# network label, chain id, RPC URL and contract address. The variables below
# override it.
MONADB_DEPLOYMENT=

# Label shown in /status: testnet | mainnet | localnet
MONAD_NETWORK=testnet

# RPC endpoint. Public endpoints rate-limit and cap eth_getLogs at 100 blocks:
# the node retries 429/5xx with backoff, but a private RPC is recommended.
#   testnet:  https://testnet-rpc.monad.xyz   (chain 10143)
#   mainnet:  https://rpc.monad.xyz           (chain 143)
#   localnet: http://127.0.0.1:8545           (Hardhat, chain 31337)
# /status only shows the origin of this URL (API keys stay private).
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143

# MonaDB contract address (empty = the one in MONADB_DEPLOYMENT)
MONADB_CONTRACT=

# Replicator wallet (sends confirmations and proofs, pays their gas, receives
# the rewards). The MonaDB admin must register its address with
# registerReplicator. Either a 0x private key inline…
REPLICATOR_PRIVATE_KEY=
# …or a file holding it (REPLICATOR_PRIVATE_KEY wins when both are set)
REPLICATOR_KEY_FILE=./replicator.key

# Blocks per eth_getLogs call while rebuilding ledger chunks from their
# SegmentWritten events (halved automatically when the RPC rejects a range)
LOGS_BLOCK_RANGE=100

# Margin over eth_estimateGas, in %: Monad charges the gas LIMIT, not the gas
# used, so keep it small (the SDK also keeps at least 75 000 gas of headroom)
GAS_LIMIT_BUFFER_PCT=15

# Chunks confirmed per confirmReplications transaction (the contract skips the
# ones other nodes filled meanwhile instead of reverting)
MAX_CONFIRMATIONS_PER_TX=8

# How long to wait for a transaction receipt
TX_TIMEOUT_MS=60000

# ── Storage ────────────────────────────────────────────
# Chunk bytes: rocksdb (production / Docker) | fs (one file per chunk in
# DATA_DIR/chunks; no native module — use it outside Docker) | s3 (any
# S3-compatible object store, see below; docker-compose's default)
CHUNK_STORE=rocksdb

# Chunk + blob-shard metadata: oracle (production / Docker) | postgres
# (docker-compose's default) | file (DATA_DIR/metadata.json, queried in memory)
METADATA_STORE=oracle

# Blob shards (erasure-coded blobs, up to 1 GiB each): fs (files in BLOB_DIR) |
# s3. Empty = s3 when CHUNK_STORE=s3, fs otherwise (never RocksDB)
BLOB_STORE=

# Root for the fs / file stores, blob staging (and the default RocksDB path)
DATA_DIR=./data

# RocksDB directory (default DATA_DIR/rocksdb)
ROCKSDB_PATH=

# Committed blob shards of BLOB_STORE=fs (default DATA_DIR/blobs): point it at
# a large, cheap volume
BLOB_DIR=

# Shards still being received, for both blob stores (default
# DATA_DIR/blobs-staging; always local disk, also with s3). Needs room for the
# uploads in flight (up to 1 GiB each); staged files survive restarts so
# uploads resume.
BLOB_STAGING_DIR=

# ── S3-compatible object store (CHUNK_STORE=s3 / BLOB_STORE=s3) ──
# AWS S3, Cloudflare R2, Backblaze B2, SeaweedFS, MinIO… Chunks are stored at
# ${S3_PREFIX}chunks/<chunk id>, blob shards at ${S3_PREFIX}blobs/<blob>/<index>.
# Required with either s3 driver.
S3_BUCKET=

# Custom endpoint; empty = AWS. Examples:
#   SeaweedFS (docker compose): http://s3:8333
#   MinIO:  http://localhost:9000
#   R2:     https://<account id>.r2.cloudflarestorage.com
#   B2:     https://s3.<region>.backblazeb2.com
S3_ENDPOINT=

# Region: the bucket's region on AWS / B2 (e.g. eu-central-1, us-west-004),
# "auto" on R2. Default us-east-1 (fine for MinIO)
S3_REGION=

# Access keys; empty = the AWS default credential chain (AWS_* variables,
# profile, instance / task role). Give the node a key scoped to its bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Key prefix, so several nodes can share one bucket (e.g. node-1/); empty = none
S3_PREFIX=

# true = path-style URLs (http://endpoint/bucket/key): needed by MinIO
S3_FORCE_PATH_STYLE=false

# true = create the bucket at boot when it does not exist (otherwise the node
# refuses to start without it)
S3_CREATE_BUCKET=false

# Blob shards above this size (bytes) are committed with a multipart upload
# of S3_PART_SIZE parts (≥ 5 MiB, the S3 minimum), S3_UPLOAD_CONCURRENCY at a
# time: memory per commit ≈ part size × concurrency (16 MiB × 4 by default)
S3_MULTIPART_THRESHOLD=67108864
S3_PART_SIZE=16777216
S3_UPLOAD_CONCURRENCY=4

# ── PostgreSQL (METADATA_STORE=postgres) ───────────────
# Connection URL (add ?sslmode=require for managed databases; URL-encode
# special characters in the password). Empty = the standard libpq variables:
# PGHOST, PGPORT, PGUSER, PGPASSWORD, PGDATABASE.
# Creates the chunks and blob_shards tables (and their indexes) on first start.
DATABASE_URL=postgres://monadb:your_postgres_password@localhost:5432/monadb

# Schema for the tables (created if missing), so several nodes can share one
# database (lower-case identifier); empty = the search_path (public)
PG_SCHEMA=

# Maximum connections in the pool
PG_POOL_MAX=10

# ── Oracle DB ──────────────────────────────────────────
# Oracle connection for structured metadata (METADATA_STORE=oracle).
# Creates the CHUNKS and BLOB_SHARDS tables on first start; use a fresh schema
# (other AvaDB / SolaDB nodes' CHUNKS tables have another layout).
ORACLE_USER=monadb
ORACLE_PASSWORD=your_oracle_password
ORACLE_CONNECTION_STRING=localhost:1521/XEPDB1

# ── Replication ────────────────────────────────────────
# Public endpoint that serves /chunk/:id/data and the blob API (the SDK
# downloads from it and pushes chunks / shards to it)
NODE_ENDPOINT=http://localhost:3000

# true = at boot, send updateReplicatorEndpoint when the on-chain endpoint
# differs from NODE_ENDPOINT (max 128 bytes)
UPDATE_ENDPOINT_ON_START=false

# Delay between reads of the on-chain work queue (pendingChunks)
POLL_INTERVAL_MS=5000

# Chunks rebuilt / confirmed in parallel
REPLICATION_CONCURRENCY=5

# Economics: chunks paying less than this per replica (wei) are stored but
# not confirmed; blobs whose remaining storage pays less are not repaired
MIN_REWARD_WEI=0

# Only replicate chunks / blobs of these uploader wallets (comma-separated 0x
# addresses); empty = every uploader
REPLICATE_OWNERS=

# ── Logging ────────────────────────────────────────────
# fatal | error | warn | log | debug | verbose
LOG_LEVEL=log

# ── Blobs (erasure-coded shards, docs/blob-protocol.md) ─────────────────────
# Maintenance loop: answer storage challenges, prove + claim, rebuild vacant slots
BLOBS_ENABLED=true
BLOB_POLL_INTERVAL_MS=10000
BLOB_REPAIR=true
# Challenge random shards of co-holders and of blobs in the work queue (bounty
# when they fail)
BLOB_CHALLENGE_OTHERS=false
BLOB_CHALLENGE_INTERVAL_MS=600000
# Prove and claim once this many wei accrued on a shard (default 0.05 MON: a
# self-challenge, its proof and the claim cost ~300k gas, ~0.03 MON at Monad's
# 100 gwei base fee; expired blobs are claimed whatever the amount)
BLOB_CLAIM_MIN_WEI=50000000000000000
BLOB_LEAF_CACHE_BYTES=268435456
# Largest shard accepted or rebuilt (the SDK makes shards of at most 1 GiB)
BLOB_MAX_SHARD_BYTES=2147483648
