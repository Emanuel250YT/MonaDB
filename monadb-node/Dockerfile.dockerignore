# Build context = repo root (docker build -f monadb-node/Dockerfile .).
# BuildKit uses this file instead of a root .dockerignore.  It allowlists what
# the image needs, so keys (.keys), .env files, Hardhat artifacts and
# node_modules never reach the Docker daemon.
*
!sdk/package.json
!sdk/tsconfig.json
!sdk/src
!monadb-node/package.json
!monadb-node/package-lock.json
!monadb-node/tsconfig.json
!monadb-node/tsconfig.build.json
!monadb-node/nest-cli.json
!monadb-node/src
**/*.spec.ts
