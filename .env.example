# Deployer = admin of the contract (updateConfig, registerReplicator). Localnet
# uses Hardhat's dev account #0 when this is empty.
DEPLOYER_PRIVATE_KEY=

# Replicators to register on init (comma-separated, one endpoint per address).
# Localnet registers dev accounts #1–#4 at http://localhost:3000–3003 by default.
REPLICATOR_ADDRESSES=
REPLICATOR_ENDPOINTS=
# Public node URLs written to deployments/*.json for SDK users (default: the active replicators)
MONADB_NODE_URLS=
# fund-replicator: MON each replicator is topped up to
FUND_REPLICATOR_MON=1

# RPC overrides
LOCALNET_RPC_URL=http://127.0.0.1:8545
TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MAINNET_RPC_URL=https://rpc.monad.xyz
# Monadscan (Etherscan V2) verification; MonadVision (Sourcify) needs no key
ETHERSCAN_API_KEY=

# Pricing, in wei of MON (per requested replica) — init applies them, updateConfig afterwards.
# Defaults ≈ SolaDB's USD prices at MON ≈ USD 0.02.
UPLOAD_BASE_FEE_PER_REPLICA=20000000000000000
UPLOAD_PRICE_PER_MIB=100000000000000000
PROTOCOL_FEE_BPS=1000
REPLICATION_THRESHOLD_PCT=60
REPLICATION_WINDOW_SECONDS=604800
# Blobs (erasure-coded storage, docs/blob-protocol.md)
EPOCH_SECONDS=2592000
PRICE_PER_MIB_EPOCH=1000000000000000
# Blocks to answer a storage challenge (≤ 240: BLOCKHASH reaches 256 blocks back; 200 ≈ 80 s on Monad)
CHALLENGE_WINDOW_BLOCKS=200
CHALLENGE_COOLDOWN_SECONDS=3600
CHALLENGER_BOUNTY_BPS=1000
# Receives the protocol share (default: the admin)
TREASURY_ADDRESS=

# Hardhat node block interval for `npm run localnet`
LOCALNET_BLOCK_MS=1000

# e2e
UPLOADER_PRIVATE_KEY=
NODE_URL=http://localhost:3000
# measure-costs
MONAD_GAS_PRICE_GWEI=100
MON_USD=0.02
