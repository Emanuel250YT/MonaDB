{
  "name": "monadb",
  "version": "1.0.0",
  "description": "MonaDB — private, replicated file storage on Monad",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "sdk",
    "app"
  ],
  "scripts": {
    "compile": "hardhat compile",
    "test:contracts": "hardhat test",
    "localnet": "hardhat node",
    "nodes:localnet": "tsx monadb-node/test/local-nodes.ts",
    "export-abi": "tsx scripts/export-abi.ts",
    "build:sdk": "npm run build -w @monadb/sdk",
    "test:sdk": "npm run build:test -w @monadb/sdk && npm test -w @monadb/sdk",
    "deploy:localnet": "tsx scripts/deploy.ts localnet",
    "deploy:testnet": "tsx scripts/deploy.ts testnet",
    "deploy:mainnet": "tsx scripts/deploy.ts mainnet",
    "init:localnet": "tsx scripts/init.ts localnet",
    "init:testnet": "tsx scripts/init.ts testnet",
    "init:mainnet": "tsx scripts/init.ts mainnet",
    "verify:testnet": "hardhat run scripts/verify.ts --network monadTestnet",
    "verify:mainnet": "hardhat run scripts/verify.ts --network monadMainnet",
    "fund-replicator:testnet": "tsx scripts/fund-replicator.ts testnet",
    "e2e:localnet": "tsx scripts/e2e.ts localnet",
    "e2e:testnet": "tsx scripts/e2e.ts testnet",
    "measure-costs": "tsx scripts/measure-costs.ts",
    "lint:sol": "solhint \"contracts/**/*.sol\"",
    "app:dev": "npm run dev -w @monadb/app",
    "app:build": "npm run build -w @monadb/app"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.2",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-verify": "^2.1.3",
    "@openzeppelin/contracts": "^5.6.1",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "chai": "^4.5.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.17.0",
    "hardhat": "^2.29.1",
    "solhint": "^6.2.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "repository": {
    "url": "https://github.com/Emanuel250YT/MonaDB",
    "type": "git"
  }
}
